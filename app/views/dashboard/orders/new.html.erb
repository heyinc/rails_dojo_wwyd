<h1>注文作成</h1>

<h2>予約情報</h2>
<div class="reservation-info">
  <dl>
    <dt>予約ID</dt>
    <dd><%= @order.reservation.id %></dd>
    <dt>お客様名</dt>
    <dd><%= @order.name %></dd>
    <dt>メールアドレス</dt>
    <dd><%= @order.email %></dd>
    <dt>予約日</dt>
    <dd><%= @order.reservation.date.strftime("%Y年%m月%d日") %></dd>
    <dt>予約時間</dt>
    <dd><%= @order.reservation.time.strftime("%H:%M") %></dd>
  </dl>
</div>

<h2>注文情報</h2>
<%= form_with model: [:dashboard, @order], local: true do |form| %>
  <%= form.hidden_field :reservation_id %>

  <div class="field">
    <%= form.label :item_id, "購入商品" %>
    <%= form.collection_select :item_id, @items, :id, :name, { prompt: "商品を選択してください" }, { required: true } %>
  </div>

  <div class="field">
    <%= form.label :user_id, "担当者" %>
    <%= form.collection_select :user_id, @users, :id, :name, { selected: Current.user.id, prompt: "担当者を選択してください" }, { required: true } %>
  </div>

  <h3>カード情報</h3>
  <div class="field">
    <%= form.label :card_number, "カード番号" %>
    <input type="text" id="order_card_number" />
    <small>※クレカ情報非通過の実装を模したもので、何の値を入力しても適当な乱数をサーバーにリクエストします。</small>
  </div>

  <%= form.hidden_field :token, value: SecureRandom.alphanumeric(32) %>

  <div class="actions">
    <%= form.submit "注文を登録" %>
  </div>
<% end %>
